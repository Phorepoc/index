{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Phorepoc/index/schema/listing.schema.json",
  "title": "A Phorepoc listing: one installable item and the releases this index approves",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "summary", "category", "license", "source", "releases", "compatibility"],
  "properties": {
    "id": {
      "description": "Unique id, the listing folder's name: lower case, digits, '-' and '.'",
      "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,62}$"
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "summary": {"description": "One line", "type": "string", "minLength": 1, "maxLength": 140},
    "description": {"description": "Plain text or Markdown; listing.md next to listing.json is used when this is absent",
                    "type": "string"},
    "category": {"enum": ["app", "game", "driver", "library", "codec", "theme", "tool", "system"]},
    "license": {"description": "SPDX expression", "type": "string", "minLength": 1},
    "homepage": {"type": "string", "format": "uri"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "source": {
      "description": "Where the releases come from",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repo"],
      "properties": {
        "type": {"enum": ["github"]},
        "repo": {"description": "owner/name", "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "asset": {"description": "Regular expression the installable asset's file name must match (default: \\.sisx?$)",
                  "type": "string"}
      }
    },
    "releases": {
      "description": "The releases this index approves: explicit tags, or \"latest\" for the newest non-prerelease",
      "oneOf": [
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        {"const": "latest"}
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch"],
      "properties": {
        "arch": {"type": "array", "minItems": 1, "items": {"enum": ["arm", "x32"]}},
        "boards": {"description": "Absent = any board of the architecture",
                   "type": "array", "items": {"type": "string"}},
        "min_core": {"description": "Lowest core release, e.g. \"1.0\"", "type": "string"},
        "legacy": {"description": "Runs on stock Symbian OS 9.x phones too (not only Phorepoc)", "type": "boolean"},
        "needs_platsec_hack": {"description": "Installs only on a phone whose platform security is patched",
                               "type": "boolean"}
      }
    },
    "requires": {"description": "Ids of other listings that must be installed first",
                 "type": "array", "items": {"type": "string"}},
    "icon": {"description": "File in the listing folder (PNG, square, >= 128 px)", "type": "string"},
    "screenshots": {"description": "Files in the listing folder", "type": "array", "items": {"type": "string"}}
  }
}
